# Core CLI settings
# The guided launcher will create .env from this file on first run.
# Keep TELEGRAM_BOT_TOKEN here so config.json can stay secret-free.
# Most users only need to set TELEGRAM_BOT_TOKEN manually.
# Alias, scope, and agent settings can be filled by the setup UI after `./start.sh`.
CONFIG_PATH=./config.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
TELEGRAM_USER_ID=

# Herd config overrides
# These are optional. The setup UI can write them for you.
HERD_INVITE_TOKEN=
HERD_ALIAS=
HERD_SCOPE=
HERD_CARGO=
HERD_ALLOW_PROJECT_CHANGES=true

# Agent config overrides
# These are optional too. Use them only if you want to override what the UI saved.
HERD_AGENT_TYPE=
HERD_AGENT_COMMAND=
HERD_AGENT_ARGS=
HERD_AGENT_MODE=
HERD_AGENT_PROMPT_MODE=
